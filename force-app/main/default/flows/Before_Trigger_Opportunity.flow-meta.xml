        <name>fmlaAddendumNotes</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Closing_Costs_Credits_Post_Appraisal__c})), 
&quot;Seller to Pay &quot;&amp;TEXT({!$Record.Closing_Costs_Credits_Post_Appraisal__c})&amp;&quot;% towards buyer&apos;s closing costs or prepaids&quot;, &quot;&quot;) &amp;BR()&amp;
IF(NOT(ISBLANK({!$Record.Price_Reduction_Flat_Fee_Post_Appraisal__c})), 
&quot;Price Reduction/Flat Fee of: $&quot;&amp;TEXT({!$Record.Price_Reduction_Flat_Fee_Post_Appraisal__c}), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fmlaCloseDateDay</name>
        <dataType>String</dataType>
        <expression>CASE( WEEKDAY({!$Record.CloseDate}), 
1, &quot;Sunday&quot;,
2, &quot;Monday&quot;,
3, &quot;Tuesday&quot;,
4, &quot;Wednesday&quot;,
5, &quot;Thursday&quot;,
6, &quot;Friday&quot;,
7, &quot;Saturday&quot;,
&quot;Unknown&quot;
)</expression>
    </formulas>
