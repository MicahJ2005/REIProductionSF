        <name>fmlaPropertyState</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!$Record.Property_Zip_Code__c}, &quot;7&quot;), &quot;TX&quot;, &quot;TN&quot;)</expression>
    </formulas>
    <formulas>
