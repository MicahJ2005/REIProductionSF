<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Check_If_Member_Found</name>
        <label>Check If Member Found</label>
        <locationX>100</locationX>
        <locationY>700</locationY>
        <defaultConnectorLabel>No Member Found</defaultConnectorLabel>
        <rules>
            <name>Member_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Next_Member.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Owner</targetReference>
            </connector>
            <label>Member Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Round_Robin_Eligibility</name>
        <label>Check Round Robin Eligibility</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Not Eligible</defaultConnectorLabel>
        <rules>
            <name>Is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Investor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.Alias</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>hubspot</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Active_Queue</targetReference>
            </connector>
            <label>Is Eligible</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Incremented_Lead_Count</name>
        <dataType>Number</dataType>
        <expression>{!Get_Next_Member.Leads_Assigned__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Lead Round Robin Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Round Robin Assignment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_Queue</name>
        <label>Get Active Queue</label>
        <locationX>100</locationX>
        <locationY>450</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Next_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>HubSpot Investor Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Round_Robin_Queue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Next_Member</name>
        <label>Get Next Member</label>
        <locationX>100</locationX>
        <locationY>575</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Member_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Round_Robin_Queue__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Active_Queue.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Is_User_Active_And_Present__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Round_Robin_Member__c</object>
        <sortField>Allocation_Ratio__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Lead_Owner</name>
        <label>Update Lead Owner</label>
        <locationX>50</locationX>
        <locationY>825</locationY>
        <connector>
            <targetReference>Update_Member_Stats</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Next_Member.User__c</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Member_Stats</name>
        <label>Update Member Stats</label>
        <locationX>50</locationX>
        <locationY>950</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Next_Member.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Assigned_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Leads_Assigned__c</field>
            <value>
                <elementReference>Incremented_Lead_Count</elementReference>
            </value>
        </inputAssignments>
        <object>Round_Robin_Member__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Round_Robin_Eligibility</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
