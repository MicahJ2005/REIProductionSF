    <description>Autolaunched Flow to create a Project Invoice for the Draw Check Interior.  This Flow needs a Process Builder trigger to initiate it.
Uses Global PL</description>
    <interviewLabel>Project Create Draw Check Interior from Process {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Project Create Draw Check Interior from Process-2</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This auto launch Flow creates a Project Invoice for the first draw check, Draw Check Start.</description>
        <name>Create_a_Project_Invoice_for_Draw_Check_Start</name>
        <label>Create a Project Invoice for Draw Check Start</label>
        <locationX>222</locationX>
        <locationY>80</locationY>
        <assignRecordIdToReference>VarTNewProjectInvoiceID</assignRecordIdToReference>
        <inputAssignments>
            <field>CategoryGlobal__c</field>
            <value>
                <stringValue>Cosmetic List</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Draw_Check__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Amount__c</field>
            <value>
                <elementReference>VarCurrencyInvoiceAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Number__c</field>
            <value>
                <elementReference>ConInteriorInvoiceNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project__c</field>
            <value>
                <elementReference>VarTProjectID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Vendor_Acct__c</field>
            <value>
                <elementReference>VarTVendor</elementReference>
            </value>
        </inputAssignments>
        <object>Project_Invoices__c</object>
    </recordCreates>
    <startElementReference>Create_a_Project_Invoice_for_Draw_Check_Start</startElementReference>
    <status>Active</status>
    <variables>
