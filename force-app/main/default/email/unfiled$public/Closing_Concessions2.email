<![CDATA[<div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;">Opportunity:&nbsp;{!Opportunity.Name} - {!Opportunity.Market__c}</div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;">Investor: {!Opportunity.Account}</div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><span style="font-size: 12pt;">Waive Placement Fee:&nbsp;</span><span style="font-size: 12pt;">{!If(Opportunity.Waive_Placement_Fee__c,"Yes","")}</span></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;">{!If(Opportunity.Waive_Placement_Fee_Post_Appraisal__c,"Yes","")}</div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;">WOW Status: {!Opportunity.WOW_Status__c}</div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style=""><span style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;">PM Fee REDUCTION %:&nbsp;</span><font style="color: rgb(0, 0, 0); font-family: arial;">{!Opportunity.Property_Management_Reduction__c}</font><span style="font-family: arial;"><font style="">{!Opportunity.Property_Management_Reduction_P_A__c}</font></span></div><div style="color: rgb(0, 0, 0); font-family: arial;"><span style="font-size: 12pt;">Number of Months:&nbsp;&nbsp;</span>{!Opportunity.For_x_Months__c}{!Opportunity.For_x_Months_Post_Appraisal__c}</div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div><div style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></div>]]></td>
