<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>New Task Assigned</fullName>
        <actions>
            <name>New_Task_Assigned</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <formula>AND (  NOT(ISPICKVAL(Status, &apos;Completed&apos;)),    CONTAINS(Subject, &apos;One To One&apos;)  )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Send New PPMG Accounting Task Alert</fullName>
        <actions>
            <name>New_PPMG_Accounting_Task</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Task.RecordTypeId</field>
            <operation>equals</operation>
            <value>Accounting</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Update Type to Email</fullName>
        <actions>
            <name>Update_Type_to_Email</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Task.Subject</field>
            <operation>startsWith</operation>
            <value>Email</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
