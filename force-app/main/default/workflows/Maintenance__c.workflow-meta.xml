<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>CS Over %24400 Call To Do</fullName>
        <actions>
            <name>Over_400_Call_To_Do_for_CS</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Maintenance__c.Over_400_Status__c</field>
            <operation>equals</operation>
            <value>Sent to Customer Service</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Created to Dispatch</fullName>
        <actions>
            <name>UpdateUtilOpentoDispatch</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(
ISCHANGED(Repair_Status__c),
TEXT(Repair_Status__c) = &quot;Dispatched&quot;
)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>RStatusTimeStamp</fullName>
        <actions>
            <name>RStatusTimeStamp</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Maintenance__c.Repair_Status__c</field>
            <operation>equals</operation>
            <value>Standby - Needs Info</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>RStatusTotalDays</fullName>
        <actions>
            <name>RStatusTotalDays</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND ( ISCHANGED (Repair_Status__c), ISPICKVAL( PRIORVALUE (Repair_Status__c), &apos;Standby - Needs Info&apos;))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Set Dispatch Date</fullName>
        <actions>
            <name>Update_Dispatch_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Maintenance__c.Repair_Status__c</field>
            <operation>equals</operation>
            <value>Dispatched</value>
        </criteriaItems>
        <description>When a Maintenance Repair Status is set to Dispatched this WF will timestamp the Dispatch Date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>WO Close Date</fullName>
        <actions>
            <name>Maint_Completed_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Maintenance__c.Repair_Status__c</field>
            <operation>equals</operation>
            <value>Completed</value>
        </criteriaItems>
        <description>Updates Maintenance.Completed_Date__c with today&apos;s date when Repair Status = Completed</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Work Order Created Date</fullName>
        <actions>
            <name>Work_Order_Created_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Maintenance__c.Work_Order_Status__c</field>
            <operation>equals</operation>
            <value>Open</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
