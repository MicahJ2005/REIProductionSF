<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>Buyback Completed Flow</fullName>
        <actions>
            <name>Buyback_Completed_Notification</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.LeadSource</field>
            <operation>equals</operation>
            <value>Resale</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Purchased</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Buyback Started Flow</fullName>
        <actions>
            <name>Buyback_Started_Notification</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.LeadSource</field>
            <operation>equals</operation>
            <value>Resale</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Under Contract - Sent to Title</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Closing Concessions</fullName>
        <actions>
            <name>Oppy_Closing_Concessions</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <formula>ISCHANGED(Closing_Concessions__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Email Scope To Buyer</fullName>
        <actions>
            <name>Email_Scope_to_Buyer</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Closing_Stage__c</field>
            <operation>equals</operation>
            <value>Start,Disclosures,Appraisal Ordered,Appraisal Received,Conditions,C2C,Closing Docs Out to Buyer,Signed Closing Docs</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Cost_Sheet_Scope__c</field>
            <operation>equals</operation>
            <value>Completed</value>
        </criteriaItems>
        <description>Notice for the closing department to email the scope to the buyer</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Email for Contract Executed</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity.Contract_Executed__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>House Sold need titling</fullName>
        <actions>
            <name>House_sold_need_titling</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>House Sold- Need Titling</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>New Priority House Alert</fullName>
        <actions>
            <name>New_Priority_House_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>HOT: Contract-Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.House_Sold_Email_Sent__c</field>
            <operation>equals</operation>
            <value>No</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Closing_Stage__c</field>
            <operation>notEqual</operation>
            <value>CLOSED</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Purchase_Method__c</field>
            <operation>equals</operation>
            <value>Conventional</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Offer Sheet Approved</fullName>
        <actions>
            <name>Offer_Sheet_Approved</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.RecordTypeId</field>
            <operation>equals</operation>
            <value>Buy</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Offer Sheet Approved</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Offer Sheet Submitted</fullName>
        <actions>
            <name>Offer_Sheet_Submitted</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.RecordTypeId</field>
            <operation>equals</operation>
            <value>Buy</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Offer Sheet Submit</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Opportunity Contract Executed</fullName>
        <actions>
            <name>Opportunity_Contract_Executed</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Opportunity_Contract_Executed_Sent</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Contract_Status</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Contract_Executed__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Util_Contract_Executed__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.RecordTypeId</field>
            <operation>notEqual</operation>
            <value>Listings</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Oppt Cash to Cash</fullName>
        <actions>
            <name>Oppt_Cash_to_Cash</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Purchase_Method__c</field>
            <operation>equals</operation>
            <value>Cash</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>HOT: Contract-Won</value>
        </criteriaItems>
        <description>Update the Lender to Cash when the Purchase Method is Cash</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Oppt IRA Cash to SD IRA Cash</fullName>
        <actions>
            <name>Oppt_IRA_Cash_to_SDIRA_Cash</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Purchase_Method__c</field>
            <operation>equals</operation>
            <value>SD-IRA Cash</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>HOT: Contract-Won</value>
        </criteriaItems>
        <description>Update the Lender to SDIRA Cash when the Purchase Method is SD-IRA Cash</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Property State to TN</fullName>
        <actions>
            <name>Property_State_to_TN</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Property_Zip_Code__c</field>
            <operation>startsWith</operation>
            <value>3</value>
        </criteriaItems>
        <description>update property state to TN</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Property State to TX</fullName>
        <actions>
            <name>Update_Property_State_TX</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Property_Zip_Code__c</field>
            <operation>startsWith</operation>
            <value>7</value>
        </criteriaItems>
        <description>update property state to TX</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Sale Lost Alert</fullName>
        <actions>
            <name>Sales_Lost_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Dead-Lost,Lost - Buyer Did Not Qualify,Contract Lost - Backed Out</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Closing_Stage__c</field>
            <operation>notEqual</operation>
            <value>CLOSED</value>
        </criteriaItems>
        <description>Alert to Carol, Ryan, and Marq when a sale is lost.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Sale Lost Alert Fortune Builders</fullName>
        <actions>
            <name>Lost_Sale_Alert_to_Fortune_Builders</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Contract Lost - Backed Out,Lost - Buyer Did Not Qualify,Dead-Lost</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Closing_Stage__c</field>
            <operation>notEqual</operation>
            <value>CLOSED</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Referred_by_Affiliate__c</field>
            <operation>equals</operation>
            <value>Fortune Builders</value>
        </criteriaItems>
        <description>Alert to Paul Shively when an FB sale is lost</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>TX House Is Sold Alert</fullName>
        <actions>
            <name>TX_House_Sold_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>HOT: Contract-Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Closing_Stage__c</field>
            <operation>notEqual</operation>
            <value>CLOSED</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.House_Sold_Email_Sent__c</field>
            <operation>notEqual</operation>
            <value>Yes</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Prop_State__c</field>
            <operation>equals</operation>
            <value>tx</value>
        </criteriaItems>
        <description>Alert to Ashley Ware when TX house is sold</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Cancellation Date</fullName>
        <actions>
            <name>Update_Cancellation_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Cancel_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Cancelled</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.IsClosed</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update The Sale Date - No Saturdays</fullName>
        <actions>
            <name>Increase_Sale_Date_by_1</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.CloseDate</field>
            <operation>greaterThan</operation>
            <value>1/1/2015</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>HOT: Contract-Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Day_of_Week__c</field>
            <operation>equals</operation>
            <value>Saturday</value>
        </criteriaItems>
        <description>This workflow will update the sale date and move it one day ahead if the sale date falls on a Saturday.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
