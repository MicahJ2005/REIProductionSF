<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>Project Item Complete</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Project_Item__c.Status__c</field>
            <operation>equals</operation>
            <value>Completed,Completed SWR</value>
        </criteriaItems>
        <criteriaItems>
            <field>Project_Item__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Maintenance</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Project Item Name</fullName>
        <actions>
            <name>Update_Project_Item_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Project_Item__c.RecordTypeId</field>
            <operation>notEqual</operation>
            <value>Maintenance</value>
        </criteriaItems>
        <description>Only for Non Maintaince</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
