<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <rules>
        <fullName>Add Re-Follow Up</fullName>
        <actions>
            <name>ast_Re_Follow_Up1</name>
            <type>Task</type>
        </actions>
        <actions>
            <name>ast_Re_Follow_Up_2</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Lead.Re_Follow_Up_Calls__c</field>
            <operation>equals</operation>
            <value>Yes</value>
        </criteriaItems>
        <description>For adding 2 follow up phone calls to renew contact with old leads.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Lead Call In Rick</fullName>
        <actions>
            <name>Lead_Call_In_Rick</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Lead.Call_In__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.OwnerId</field>
            <operation>equals</operation>
            <value>Rick Leubbert</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Lead Source to Facebook</fullName>
        <actions>
            <name>Lead_Source_to_Facebook</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Lead.Original_Source_Data_1__c</field>
            <operation>contains</operation>
            <value>Facebook,facebook</value>
        </criteriaItems>
        <description>update the Lead Source to Facebook</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Lead Source to Search</fullName>
        <actions>
            <name>Lead_Source_to_Search</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Lead.Original_Source_Data_1__c</field>
            <operation>contains</operation>
            <value>SSL,ssl,google,bing,yahoo</value>
        </criteriaItems>
        <description>update the Lead Source to Search</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
